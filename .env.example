# ─────────────────────────────────────────────────────────────────────────────
# Hasty Tasty — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env with credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Local Docker PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/hastytasty"
DIRECT_URL="postgresql://postgres:password@localhost:5432/hastytasty"

# NextAuth Configuration
NEXTAUTH_SECRET="generate-a-secure-random-string-here"
NEXTAUTH_URL="http://localhost:3000"
